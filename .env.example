# =====================================================
# Environment variables for OnTrack
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file with real secrets.
# =====================================================

# --- Database ---
# Postgres connection string. Use a local Postgres in dev,
# Vercel Postgres / Neon / Supabase in production.
DATABASE_URL=postgres://user:password@localhost:5432/ontrack

# --- Better Auth ---
# Required. Random string ≥ 32 chars. Used to sign session cookies
# and CSRF tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret

# Optional. The public URL the app is served from in this environment.
# Falls back to VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL when set
# automatically by Vercel. Override only if you self-host.
# BETTER_AUTH_URL=http://localhost:3000

# --- Vercel (only used on Vercel deployments) ---
# Set automatically by Vercel; do not set these in .env.local.
# VERCEL_URL
# VERCEL_PROJECT_PRODUCTION_URL
