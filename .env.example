# =====================================================
# Environment variables for OnTrack
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file with real secrets.
# =====================================================

# --- Database ---
# Postgres connection string. Use a local Postgres in dev,
# Vercel Postgres / Neon / Supabase in production.
DATABASE_URL=postgres://user:password@localhost:5432/ontrack

# --- Neon Auth (Managed Better Auth) ---
# Required. Your Managed Better Auth server URL from the Neon Console.
# Console path: Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=https://your-neon-auth-url.neon.tech

# Required. Secret for signing session cookies (32+ characters).
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=replace-me-with-a-long-random-secret

# --- Vercel (only used on Vercel deployments) ---
# Set automatically by Vercel; do not set these in .env.local.
# VERCEL_URL
# VERCEL_PROJECT_PRODUCTION_URL

# --- AI tutor ---
# Google Gemini API key (https://aistudio.google.com/apikey).
# Used by /api/ai/tutor. If unset, the endpoint returns 503 with a
# clear "not configured" message instead of crashing.
GOOGLE_GENERATIVE_AI_API_KEY=
